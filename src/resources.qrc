<!--
  Optional Qt resource collection listing the plugin's icons.

  The plugin does NOT require this file to be compiled: at runtime, icons
  are loaded directly from this same folder on disk via QIcon(path) (see
  zoom_to_predefined_scale.py), which needs no build step and can never go
  stale relative to the files actually shipped.

  This .qrc is kept for developers who prefer to embed the icons into a
  compiled Qt resource module instead. To do so:

      pyside6-rcc resources.qrc -o resources.py

  (there is no PyQt6 "pyrcc6" tool; PyQt6 resource compilation is done via
  the pyside6-rcc binary, which produces output compatible with both
  bindings). If you regenerate resources.py this way, update
  zoom_to_predefined_scale.py to load icons via QIcon(":/icons/...") instead
  of a filesystem path.
-->
<RCC>
  <qresource prefix="/zoom_to_predefined_scale/icons">
    <file>icon_locked.svg</file>
    <file>icon_unlocked.svg</file>
  </qresource>
</RCC>
